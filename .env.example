# Variables locales de entorno para Nicolet Estudio

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=desarrollador
DB_PASSWORD=password_seguro_123
# Contraseña root de MySQL en Docker (solo se aplica al crear el volumen)
MYSQL_ROOT_PASSWORD=

# Primer administrador: se crea solo si la base no tiene ninguno.
# Sin APP_ADMIN_PASSWORD se genera una al azar y se muestra una vez en la consola.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Datos de ejemplo (no activar en entornos expuestos a Internet)
APP_DEMO_DATA_ENABLED=false
APP_DEMO_PASSWORD=

# Correo electrónico SMTP Gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=nacuna888@gmail.com
# Contraseña de aplicación de Google (16 caracteres, los espacios se limpian automáticamente)
MAIL_PASSWORD=
