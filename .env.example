# Variables locales de entorno para Nicolet Estudio

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=desarrollador
DB_PASSWORD=password_seguro_123
# Contraseña root de MySQL en Docker (solo se aplica al crear el volumen)
MYSQL_ROOT_PASSWORD=

# Primer administrador: se crea solo si la base no tiene ninguno.
# Sin APP_ADMIN_PASSWORD se genera una al azar y se muestra una vez en la consola.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Datos de ejemplo (no activar en entornos expuestos a Internet)
APP_DEMO_DATA_ENABLED=false
APP_DEMO_PASSWORD=

# Correo electrónico SMTP Gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=nacuna888@gmail.com
# Contraseña de aplicación de Google (16 caracteres, los espacios se limpian automáticamente)
MAIL_PASSWORD=

# Pagos con Webpay Plus. Sin estas variables se usa el ambiente de INTEGRACIÓN (pruebas, sin cobro real).
# Tarjeta de prueba VISA 4051 8856 0044 6623, CVV 123; en el banco de prueba RUT 11.111.111-1 y clave 123.
WEBPAY_ENVIRONMENT=INTEGRATION
# Solo para producción (credenciales entregadas por Transbank):
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_SECRET=
# Minutos que se bloquea un horario esperando el pago
WEBPAY_HOLD_MINUTES=15
# Cuenta principal de administración: recibe el aviso de cita pagada. Vacío = APP_ADMIN_EMAIL (o, si tampoco está, el administrador activo más antiguo)
ADMIN_NOTIFICATION_EMAIL=
