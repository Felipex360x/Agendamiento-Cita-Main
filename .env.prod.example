# Variables de entorno para producción en AWS EC2 (docker-compose.prod.yml)
# Copia este archivo a ~/app/.env en la instancia EC2 para personalizar credenciales.

# MySQL
MYSQL_ROOT_PASSWORD=root_password_123
MYSQL_DATABASE=universidad_backend
MYSQL_USER=desarrollador
MYSQL_PASSWORD=password_seguro_123

# JWT Secret (generar una cadena aleatoria de al menos 256 bits)
JWT_SECRET=superSecretJwtKeyNicoletStudioFantasyAgendamiento2026Secure256Bit

# URLs y Redes
APP_FRONTEND_URL=http://52.87.43.82
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8

# Administrador Inicial
APP_ADMIN_EMAIL=admin@nicolet.cl
APP_ADMIN_PASSWORD=AdminNicolet2026!
# Activar para forzar la actualización de contraseña del administrador si se perdió
APP_ADMIN_RESET_PASSWORD=true

# Datos de prueba (desactivado por defecto en producción)
APP_DEMO_DATA_ENABLED=false

# Correo SMTP (Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
