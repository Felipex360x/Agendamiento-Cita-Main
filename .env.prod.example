# Variables de entorno para producción (docker-compose.prod.yml).
# Copia este archivo a ~/app/.env en la instancia EC2 y reemplaza TODOS los valores CAMBIAR_*.
# No subas el .env real a git. El script scripts/ec2-bootstrap.sh lo genera solo con secretos aleatorios.
# Para generar un secreto:  openssl rand -base64 48

# MySQL (el compose se niega a arrancar si faltan MYSQL_ROOT_PASSWORD o MYSQL_PASSWORD).
# Ojo: solo se aplican al CREAR el volumen de MySQL; cambiarlos después no cambia las claves ya guardadas.
MYSQL_ROOT_PASSWORD=CAMBIAR_clave_root_mysql
MYSQL_DATABASE=universidad_backend
MYSQL_USER=desarrollador
MYSQL_PASSWORD=CAMBIAR_clave_mysql

# Firma de los tokens JWT: cadena aleatoria de al menos 256 bits (obligatoria).
JWT_SECRET=CAMBIAR_secreto_jwt_aleatorio

# URL pública y proxies de confianza (red Docker donde corre Nginx).
APP_FRONTEND_URL=http://CAMBIAR_IP_ELASTICA
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Administrador inicial: se crea solo si la base no tiene ninguno.
# Si APP_ADMIN_PASSWORD queda vacía se genera una al azar y se imprime una vez en el log del backend.
APP_ADMIN_EMAIL=admin@nicolet.cl
APP_ADMIN_PASSWORD=CAMBIAR_clave_admin
# Poner en true SOLO una vez para restablecer la clave del admin con APP_ADMIN_PASSWORD; luego volver a false.
APP_ADMIN_RESET_PASSWORD=false

# Datos de prueba (no activar en servidores expuestos a Internet)
APP_DEMO_DATA_ENABLED=false

# Correo SMTP (contraseña de aplicación de Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=nacuna888@gmail.com
MAIL_PASSWORD=
